# Copy this file to .env (same folder) and fill in your values. .env is git-ignored: never commit it.
#   cp .env.example .env

# ---- Option A: free, runs on your computer (no key, no credit) ----
# Install Ollama, then:  ollama pull aya-expanse:8b   (about 5 GB, needs ~8 GB RAM)
BASEERAH_LLM=openai
BASEERAH_BASE_URL=http://localhost:11434/v1
BASEERAH_MODEL=aya-expanse:8b
# aya-expanse is licensed for non-commercial use only; for commercial use try qwen2.5:7b (Apache 2.0).

# ---- Option B: Anthropic API (needs an API key with credit from console.anthropic.com) ----
# BASEERAH_LLM=anthropic
# ANTHROPIC_API_KEY=
# BASEERAH_MODEL=claude-sonnet-5-5

# ---- Website on Vercel, this API on your computer (see docs/DEPLOY_VERCEL.md) ----
# BASEERAH_CORS_ORIGINS=https://baseerah-ai-sigma.vercel.app,https://baseerah-ai-sss-rank-team.vercel.app
