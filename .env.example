# Copy this file to .env (same folder) and fill in your values. .env is git-ignored: never commit it.
#   cp .env.example .env

# Explanation backend: retrieval (no AI) | anthropic | openai
BASEERAH_LLM=anthropic

# Your Anthropic API key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Claude model id (default claude-sonnet-5-5; claude-opus-5-5 is stronger and costs more)
BASEERAH_MODEL=claude-sonnet-5-5

# For BASEERAH_LLM=openai with a local server such as Ollama:
# BASEERAH_BASE_URL=http://localhost:11434/v1
# BASEERAH_MODEL=qwen2.5:7b
